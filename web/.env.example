# Copy to .env.local for local development. All variables are optional —
# without them the app runs in keyless demo mode.

# Neon Postgres connection string. Enables persistence, auth, and tenancy.
DATABASE_URL=

# OpenRouter key for AI generation (https://openrouter.ai/settings/keys).
# Set a spend limit on the key itself.
OPENROUTER_API_KEY=

# Optional model overrides (defaults in src/lib/ai/models.ts)
# OUTLINER_MODELS=
# JUDGE_MODEL=
# DESIGNER_MODEL=
