# Backend
# Production / Docker:
#   DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dclaw_slide
# Local dev default (SQLite, no Postgres needed):
DATABASE_URL=sqlite+aiosqlite:///./dclaw_slide.db
APP_ENV=dev
DEBUG=true

# AI
# Provider selection: auto | ollama | openrouter | deterministic
# - auto: try Ollama (if reachable) → OpenRouter (if key set) → deterministic
# - deterministic: template fill, no LLM, always available (demo fallback)
AI_PROVIDER=auto
OLLAMA_URL=http://localhost:11434
# Change OLLAMA_MODEL to whatever you've actually pulled, e.g. "gemma4:e2b",
# "llama3.1", "qwen2.5". Check with `ollama list`.
OLLAMA_MODEL=llama3.1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
# Bump if generation gets cut off mid-stream on slow models.
AI_REQUEST_TIMEOUT=120

# Auth
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8021
